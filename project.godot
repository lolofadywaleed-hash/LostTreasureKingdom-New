; Engine configuration file.
; Lost Treasure Kingdom — Phase 0 project skeleton.
config_version=5

[application]
config/name="Lost Treasure Kingdom"
config/name_localized={"ar":"مملكة الكنوز المفقودة","en":"Lost Treasure Kingdom"}
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.09, 1)
